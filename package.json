{
  "name": "run-city-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "inspect:gpx": "node scripts/inspect-gpx.mjs",
    "validate:route": "node scripts/validate-route.mjs",
    "build:gpx-seed": "node scripts/export-osm-seed-gpx.mjs",
    "build:app-routes": "node scripts/build-app-route-data.mjs",
    "build:route-overrides": "node scripts/build-curated-route-overrides.mjs",
    "build:route-library": "node scripts/build-50-city-route-library.mjs",
    "build:parco-candidates": "node scripts/build-parco-route-candidates.mjs",
    "build:parco-geometries": "node scripts/build-parco-route-geometries.mjs",
    "audit:route-library": "node scripts/audit-route-library.mjs",
    "codoon:check": "python3 tools/codoon_migrate.py --limit 3",
    "codoon:export": "python3 tools/codoon_migrate.py",
    "codoon:build-import": "python3 tools/build_codoon_import.py"
  },
  "dependencies": {
    "@kingstinct/react-native-healthkit": "^14.0.2",
    "expo": "~54.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-location": "~19.0.8",
    "react": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-nitro-modules": "^0.36.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
